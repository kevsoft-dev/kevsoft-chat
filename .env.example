# Salin ke .env.local (dev) atau isi di Environment Variables hosting. JANGAN di-commit.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
OTP_SECRET=            # wajib, buat: openssl rand -hex 32
OWNER_EMAILS=kevsoft.cs@gmail.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
# Opsional, jika berbeda dari config.json:
# FIREBASE_API_KEY= FIREBASE_AUTH_DOMAIN= FIREBASE_PROJECT_ID= FIREBASE_APP_ID=
# Isi "report" untuk uji CSP tanpa memblokir (Content-Security-Policy-Report-Only)
# CSP_MODE=

# Berita disimpan di Firebase Realtime Database (server-only). Pilih SALAH SATU kredensial:
FIREBASE_DATABASE_URL=https://kevsoft-apps-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT=   # (disarankan) isi JSON service account dalam satu baris
# FIREBASE_DB_SECRET=       # alternatif lama: Database secret
